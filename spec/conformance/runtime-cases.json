{
  "cases": [
    {
      "name": "balanced-no-borrow",
      "definition": {
        "arena_id": "balanced-no-borrow",
        "modules": [
          {
            "module_id": "system",
            "floor_tokens": 0,
            "target_tokens": 3,
            "max_tokens": 3,
            "order": 0,
            "can_borrow": false
          },
          {
            "module_id": "memory",
            "floor_tokens": 0,
            "target_tokens": 3,
            "max_tokens": 3,
            "order": 1,
            "can_borrow": false
          }
        ]
      },
      "request": {
        "request_id": "balanced-no-borrow",
        "model": {
          "model_profile_id": "estimated",
          "context_limit_tokens": 6,
          "reserved_output_tokens": 0
        },
        "contributions": [
          {
            "module_id": "system",
            "chunks": [{"chunk_id": "rules", "content": "alpha beta"}]
          },
          {
            "module_id": "memory",
            "chunks": [{"chunk_id": "facts", "content": "gamma delta"}]
          }
        ]
      },
      "assert": {
        "max_prompt_tokens": 6,
        "must_contain": ["alpha beta", "gamma delta"],
        "expected_modules": ["system", "memory"],
        "render_order": ["alpha beta", "gamma delta"]
      }
    },
