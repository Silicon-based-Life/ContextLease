{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextlease.dev/schema/contextlease.schema.json",
  "title": "ContextLease configuration",
  "description": "Portable arena, model, provider, and prompt contribution configuration.",
  "type": "object",
  "required": ["arena", "model"],
  "properties": {
    "arena": {"$ref": "#/$defs/arena"},
    "model": {"$ref": "#/$defs/model"},
    "providers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provider"},
      "default": {}
    },
    "contributions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contribution"},
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "arena": {
      "type": "object",
      "required": ["arena_id", "modules"],
      "properties": {
        "arena_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "default": "1.0"},
        "policy_version": {"type": "string", "default": "1"},
        "framework_reserve_tokens": {"type": "integer", "minimum": 0, "default": 0},
        "admission_policy": {"type": "string", "default": "reject"},
        "metadata": {"type": "object", "default": {}},
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/module"}
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": ["module_id", "floor_tokens", "target_tokens", "max_tokens"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "floor_tokens": {"type": "integer", "minimum": 0},
        "target_tokens": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "order": {"type": "integer", "default": 0},
        "weight": {"type": "number", "exclusiveMinimum": 0, "default": 1},
        "lifecycle": {"enum": ["static", "session", "request", "turn", "ephemeral"], "default": "request"},
        "allocation": {"enum": ["fixed", "weighted", "priority", "elastic"], "default": "weighted"},
        "protection": {"enum": ["pinned", "mixed", "elastic"], "default": "mixed"},
        "reclaim": {"enum": ["none", "builtin_pipeline", "semantic_pipeline", "custom"], "default": "builtin_pipeline"},
        "render_target": {"enum": ["text", "messages", "tool_schema", "structured"], "default": "text"},
        "can_borrow": {"type": "boolean", "default": true},
        "can_lend": {"type": "boolean", "default": true},
        "reclaim_pipeline": {
          "type": "array",
          "items": {"$ref": "#/$defs/compression_step"},
          "default": []
        },
        "metadata": {"type": "object", "default": {}}
      },
      "additionalProperties": false
    },
    "compression_step": {
      "type": "object",
      "required": ["algorithm_id"],
      "properties": {
        "algorithm_id": {"type": "string", "minLength": 1},
        "options": {"type": "object", "default": {}}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["model_profile_id", "context_limit_tokens", "reserved_output_tokens"],
      "properties": {
        "model_profile_id": {"type": "string", "minLength": 1},
        "context_limit_tokens": {"type": "integer", "minimum": 1},
        "reserved_output_tokens": {"type": "integer", "minimum": 0},
        "tokenizer_id": {"type": "string", "default": "regex-estimator-v1"},
        "tokenizer_version": {"type": "string", "default": "1"},
        "count_mode": {"enum": ["exact", "estimated", "hybrid"], "default": "estimated"}
      },
      "additionalProperties": false
    },
    "provider": {
      "oneOf": [
        {"$ref": "#/$defs/openai_compatible_provider"},
        {"$ref": "#/$defs/litellm_provider"}
      ]
    },
    "provider_common": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "api_key_env": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 30}
      }
    },
    "openai_compatible_provider": {
      "allOf": [
        {"$ref": "#/$defs/provider_common"},
        {
          "type": "object",
          "required": ["type", "base_url"],
          "properties": {
            "type": {"const": "openai-compatible"},
            "model": {"type": "string", "minLength": 1},
            "base_url": {"type": "string", "format": "uri"},
            "api_key_env": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "api_key_header": {"type": "string", "default": "Authorization"},
            "api_key_prefix": {"type": "string", "default": "Bearer "},
            "extra_headers": {"type": "object", "additionalProperties": {"type": "string"}},
            "extra_body": {"type": "object"},
            "allow_insecure_http": {"type": "boolean", "default": false}
          },
          "additionalProperties": false
        }
      ]
    },
    "litellm_provider": {
      "allOf": [
        {"$ref": "#/$defs/provider_common"},
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"const": "litellm"},
            "model": {"type": "string", "minLength": 1},
            "api_key_env": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "api_base": {"type": "string", "format": "uri"},
            "options": {"type": "object", "default": {}}
          },
          "additionalProperties": false
        }
      ]
    },
    "contribution": {
      "type": "object",
      "required": ["module_id", "chunks"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
        "observed_demand_tokens": {"type": ["integer", "null"], "minimum": 0},
        "metadata": {"type": "object", "default": {}}
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": ["chunk_id", "content"],
      "properties": {
        "chunk_id": {"type": "string", "minLength": 1},
        "content": {},
        "kind": {"type": "string", "default": "text"},
        "fixed": {"type": "boolean", "default": false},
        "protection": {"enum": ["pinned", "mixed", "elastic"], "default": "elastic"},
        "priority": {"type": "number", "default": 1},
        "required_terms": {"type": "array", "items": {"type": "string"}, "default": []},
        "dependency_group": {"type": ["string", "null"]},
        "metadata": {"type": "object", "default": {}}
      },
      "additionalProperties": false
    }
  }
}
